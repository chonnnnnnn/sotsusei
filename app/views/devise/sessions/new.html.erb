<% content_for :title, "これリピ！ - ログイン" %>

<div class="font-body-md text-body-md min-h-screen flex flex-col bg-surface">
  <header class="w-full top-0 sticky bg-primary/95 backdrop-blur-md shadow-sm z-50">
    <div class="flex items-center justify-between px-container-margin h-20 w-full max-w-[1200px] mx-auto">
      <div class="flex items-center gap-3">
        <span class="material-symbols-outlined text-on-primary text-3xl">restaurant_menu</span>
        <h1 class="font-headline-lg-mobile text-headline-lg-mobile font-bold text-on-primary tracking-tight">これリピ！</h1>
      </div>
    </div>
  </header>

  <main class="flex-grow flex items-center justify-center p-6 md:p-12 lg:p-16 flex-col">
    <div class="w-full max-w-[500px] bg-white rounded-[2rem] shadow-2xl overflow-hidden flex flex-col border border-surface-container-high mx-auto">
      <div class="w-full p-8 md:p-12 flex flex-col justify-center bg-white">
        <div class="mb-10">
          <h2 class="font-headline-lg text-headline-lg text-on-surface mb-3">ログイン</h2>
          <p class="text-on-surface-variant font-body-md leading-relaxed">おかえりなさい。これまでの記録を確認しましょう。</p>
        </div>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "flex flex-col gap-6" }) do |f| %>
          <div class="flex flex-col gap-2">
            <%= f.label :email, "メールアドレス", class: "font-label-md text-on-surface-variant ml-1" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "example@mail.com",
                  class: "h-14 w-full px-5 rounded-xl border border-outline-variant bg-surface-bright text-on-surface font-body-md form-input-focus transition-all duration-200 placeholder:text-outline/50" %>
          </div>

          <div class="flex flex-col gap-2">
            <%= f.label :password, "パスワード", class: "font-label-md text-on-surface-variant ml-1" %>
            <%= f.password_field :password, autocomplete: "current-password", placeholder: "example123",
                  class: "h-14 w-full px-5 rounded-xl border border-outline-variant bg-surface-bright text-on-surface font-body-md form-input-focus transition-all duration-200 placeholder:text-outline/50" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="flex items-center gap-2 ml-1">
              <%= f.check_box :remember_me, class: "h-5 w-5 rounded border-outline-variant text-primary focus:ring-primary" %>
              <%= f.label :remember_me, "ログイン状態を保持する", class: "font-label-md text-on-surface-variant" %>
            </div>
          <% end %>

          <%= f.submit "ログイン",
                class: "mt-4 h-16 w-full bg-primary text-on-primary font-title-md text-title-md rounded-xl shadow-lg hover:bg-primary-container hover:shadow-xl active:scale-[0.98] transition-all duration-200 cursor-pointer" %>
        <% end %>

        <div class="mt-10 text-center flex flex-col gap-2">
          <p class="text-on-surface-variant font-label-md">
            アカウントをお持ちでないですか？
            <%= link_to "新規登録", new_registration_path(resource_name), class: "text-primary font-bold hover:underline ml-2 transition-colors" %>
          </p>
          <p class="text-on-surface-variant font-label-md">
            <%= link_to "パスワードをお忘れですか？", new_password_path(resource_name), class: "text-primary font-bold hover:underline transition-colors" %>
          </p>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center gap-2 opacity-40 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-500 mt-10">
      <p class="text-[10px] text-on-surface-variant/70">© <%= Time.current.year %> Kore-Repeat! All Rights Reserved.</p>
    </div>
  </main>
</div>
