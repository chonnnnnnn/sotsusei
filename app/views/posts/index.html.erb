<% if @post_type == "eat_out" %>
  <% content_for :title, "これリピ！ - 外食リスト" %>

  <div class="bg-surface text-on-surface min-h-screen flex flex-col">
    <header class="fixed top-0 w-full z-50 bg-primary shadow-sm">
      <div class="max-w-7xl mx-auto flex justify-between items-center px-container-margin py-4">
      <div class="flex-1 flex items-center">
        <h1 class="font-headline-lg text-headline-lg font-black text-on-primary">これリピ！</h1>
      </div>
      <nav class="hidden md:flex items-center gap-stack-md">
        <%= link_to "購入品", posts_path(post_type: "purchase"), class: "text-on-primary/80 hover:bg-white/10 transition-colors px-3 py-2 rounded-lg font-label-md text-label-md" %>
        <%= link_to "外食", posts_path(post_type: "eat_out"), class: "text-on-primary font-bold border-b-2 border-on-primary px-3 py-2 font-label-md text-label-md" %>
      </nav>
      <div class="flex-1 flex items-center justify-end gap-stack-sm text-on-primary">
        <%= link_to edit_user_registration_path, class: "p-2 hover:bg-white/10 rounded-full transition-colors active:scale-95 duration-200" do %>
          <span class="material-symbols-outlined">account_circle</span>
        <% end %>
        <%= button_to destroy_user_session_path, method: :delete,
              class: "p-2 hover:bg-white/10 rounded-full transition-colors active:scale-95 duration-200",
              form: { class: "contents" } do %>
          <span class="material-symbols-outlined">logout</span>
        <% end %>
      </div>
    </div>
    </header>

    <main class="pt-24 pb-24 md:pb-stack-lg px-container-margin max-w-7xl mx-auto w-full flex-grow">
      <%= form_with url: posts_path, method: :get, local: true,
            class: "bg-surface-container-lowest rounded-xl shadow-sm p-stack-md md:p-stack-lg mb-section-gap border border-outline-variant mt-stack-md" do %>
        <%= hidden_field_tag :post_type, "eat_out" %>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-stack-md">
          <div class="flex flex-col gap-unit">
            <%= label_tag :name, "キーワード", class: "font-label-sm text-label-sm text-on-surface-variant px-1" %>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-sm">search</span>
              <%= text_field_tag :name, params[:name], placeholder: "店名・料理名で検索",
                    class: "w-full pl-10 pr-4 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all font-body-md text-body-md" %>
            </div>
          </div>

          <div class="flex flex-col gap-unit">
            <%= label_tag :genre, "カテゴリー", class: "font-label-sm text-label-sm text-on-surface-variant px-1" %>
            <%= select_tag :genre,
                  options_for_select(Post::GENRE_LABELS.except(:product).map { |value, label| [label, value] }, params[:genre]),
                  include_blank: "すべて",
                  class: "w-full px-4 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary outline-none font-body-md text-body-md appearance-none cursor-pointer" %>
          </div>

          <div class="flex flex-col gap-unit">
            <%= label_tag :prefecture, "都道府県", class: "font-label-sm text-label-sm text-on-surface-variant px-1" %>
            <%= select_tag :prefecture, options_for_select(Post::PREFECTURES, params[:prefecture]), include_blank: "全国",
                  class: "w-full px-4 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary outline-none font-body-md text-body-md appearance-none cursor-pointer" %>
          </div>
        </div>

        <div class="mt-stack-md flex flex-col gap-unit md:max-w-sm">
          <%= label_tag :date_from, "日付", class: "font-label-sm text-label-sm text-on-surface-variant px-1" %>
          <div class="flex items-center gap-2">
            <%= date_field_tag :date_from, @date_from,
                  class: "flex-1 min-w-0 px-3 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary outline-none font-body-md text-body-md" %>
            <span class="text-on-surface-variant text-label-sm shrink-0">〜</span>
            <%= date_field_tag :date_to, @date_to,
                  class: "flex-1 min-w-0 px-3 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary outline-none font-body-md text-body-md" %>
          </div>
        </div>

        <div class="mt-stack-md flex flex-wrap items-center gap-stack-sm">
          <span class="font-label-sm text-label-sm text-on-surface-variant mr-2">リピ判定:</span>
          <% Post::REPEAT_INTENTION_LABELS.each do |value, label| %>
            <label class="flex items-center gap-1 cursor-pointer group">
              <%= check_box_tag "repeat_intentions[]", value, @repeat_intentions.include?(value.to_s),
                    id: "repeat_intention_#{value}", class: "hidden peer" %>
              <div class="px-4 py-1.5 rounded-full border border-outline-variant peer-checked:bg-primary-fixed peer-checked:border-primary-container peer-checked:text-on-primary-fixed-variant transition-all font-label-md text-label-md">
                <%= label %>
              </div>
            </label>
          <% end %>
          <%= submit_tag "検索する",
                class: "ml-auto mt-4 md:mt-0 w-full md:w-auto px-10 py-3 bg-primary text-on-primary font-bold rounded-lg hover:opacity-90 transition-all active:scale-95 shadow-md cursor-pointer" %>
        </div>
      <% end %>

      <% if @posts.any? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-gutter">
          <% @posts.each do |post| %>
            <div class="bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition-shadow group border border-transparent hover:border-outline-variant">
              <%= link_to post_path(post), class: "block" do %>
                <div class="relative aspect-[4/3] overflow-hidden bg-surface-container-high">
                  <% if post.image.attached? %>
                    <%= image_tag post.image, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center text-outline">
                      <span class="material-symbols-outlined text-5xl">restaurant</span>
                    </div>
                  <% end %>
                </div>
                <div class="p-stack-md pb-0 flex flex-col gap-unit">
                  <div class="flex justify-between items-start">
                    <span class="font-label-sm text-label-sm text-primary bg-primary-fixed px-2 py-0.5 rounded"><%= post.genre_label %></span>
                    <span class="text-on-surface-variant font-label-sm text-label-sm"><%= post.date.strftime("%Y.%m.%d") %></span>
                  </div>
                  <h3 class="font-title-md text-title-md text-on-surface line-clamp-1"><%= post.name %></h3>
                  <p class="text-on-surface-variant font-body-md text-body-md line-clamp-1"><%= post.prefecture.presence || "―" %></p>
                </div>
              <% end %>

              <div class="px-stack-md pb-stack-md pt-stack-sm mt-stack-sm mx-stack-md border-t border-outline-variant flex items-center justify-between">
                <% icon, color = repeat_intention_icon(post) %>
                <div class="flex items-center gap-1 <%= color %>">
                  <span class="material-symbols-outlined fill-icon text-xl"><%= icon %></span>
                  <span class="font-label-md text-label-md"><%= post.repeat_intention_label %></span>
                </div>
                <%= link_to edit_post_path(post), class: "p-2 rounded-full hover:bg-surface-container-low transition-colors" do %>
                  <span class="material-symbols-outlined text-outline">more_horiz</span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-center text-on-surface-variant py-stack-lg">該当する投稿がありません</p>
      <% end %>

      <%= link_to new_post_path(post_type: "eat_out"),
            class: "fixed bottom-24 md:bottom-10 right-6 md:right-10 w-14 h-14 md:w-16 md:h-16 bg-primary text-on-primary rounded-full shadow-2xl flex items-center justify-center hover:scale-110 active:scale-95 transition-transform duration-200 z-40" do %>
        <span class="material-symbols-outlined text-3xl">add</span>
      <% end %>
    </main>

    <footer class="w-full py-stack-lg flex-col items-center gap-stack-sm border-t border-primary-fixed-dim bg-primary-fixed mb-16 md:mb-0 hidden md:flex">
      <div class="font-title-md text-title-md font-bold text-on-primary-fixed-variant">これリピ！</div>
      <p class="text-on-primary-fixed-variant font-label-sm text-label-sm mt-stack-sm">© <%= Time.current.year %> これリピ！</p>
    </footer>

    <nav class="md:hidden fixed bottom-0 left-0 w-full bg-white flex justify-around items-center py-3 border-t border-outline-variant/30 z-50">
      <%= link_to posts_path(post_type: "eat_out"), class: "flex flex-col items-center gap-1 text-primary" do %>
        <span class="material-symbols-outlined fill-icon">restaurant</span>
        <span class="text-[10px] font-bold">外食</span>
      <% end %>
      <%= link_to posts_path(post_type: "purchase"), class: "flex flex-col items-center gap-1 text-on-surface-variant" do %>
        <span class="material-symbols-outlined">shopping_bag</span>
        <span class="text-[10px] font-bold">購入品</span>
      <% end %>
      <button type="button" class="flex flex-col items-center gap-1 text-on-surface-variant/40" disabled>
        <span class="material-symbols-outlined">favorite</span>
        <span class="text-[10px] font-bold">マイリスト</span>
      </button>
      <button type="button" class="flex flex-col items-center gap-1 text-on-surface-variant/40" disabled>
        <span class="material-symbols-outlined">person</span>
        <span class="text-[10px] font-bold">プロフィール</span>
      </button>
    </nav>
  </div>
<% elsif @post_type == "purchase" %>
  <% content_for :title, "投稿一覧 - 購入品 | これリピ！" %>

  <div class="bg-surface text-on-surface font-body-md min-h-screen flex flex-col">
    <header class="fixed top-0 w-full z-50 shadow-sm bg-primary">
      <div class="max-w-7xl mx-auto flex justify-between items-center px-container-margin py-4">
      <div class="flex-1 flex items-center">
        <h1 class="font-headline-lg text-headline-lg font-black text-on-primary">これリピ！</h1>
      </div>
      <nav class="hidden md:flex items-center gap-stack-md">
        <%= link_to "購入品", posts_path(post_type: "purchase"), class: "text-on-primary font-bold border-b-2 border-on-primary px-3 py-2 font-label-md text-label-md" %>
        <%= link_to "外食", posts_path(post_type: "eat_out"), class: "text-on-primary/80 hover:bg-white/10 transition-colors px-3 py-2 rounded-lg font-label-md text-label-md" %>
      </nav>
      <div class="flex-1 flex items-center justify-end gap-stack-sm text-on-primary">
        <%= link_to edit_user_registration_path, class: "p-2 hover:bg-white/10 rounded-full transition-colors active:scale-95 duration-200" do %>
          <span class="material-symbols-outlined">account_circle</span>
        <% end %>
        <%= button_to destroy_user_session_path, method: :delete,
              class: "p-2 hover:bg-white/10 rounded-full transition-colors active:scale-95 duration-200",
              form: { class: "contents" } do %>
          <span class="material-symbols-outlined">logout</span>
        <% end %>
      </div>
    </div>
    </header>

    <main class="pt-24 pb-24 md:pb-stack-lg px-container-margin max-w-7xl mx-auto w-full flex-grow">
      <%= form_with url: posts_path, method: :get, local: true,
            class: "bg-surface-container-lowest rounded-xl shadow-sm p-stack-md md:p-stack-lg mb-section-gap border border-outline-variant mt-stack-md" do %>
        <%= hidden_field_tag :post_type, "purchase" %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-stack-md">
          <div class="flex flex-col gap-unit">
            <%= label_tag :name, "キーワード", class: "font-label-sm text-label-sm text-on-surface-variant px-1" %>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-sm">search</span>
              <%= text_field_tag :name, params[:name], placeholder: "例：アイス、冷凍餃子",
                    class: "w-full pl-10 pr-4 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all font-body-md text-body-md" %>
            </div>
          </div>

          <div class="flex flex-col gap-unit">
            <%= label_tag :genre, "カテゴリー", class: "font-label-sm text-label-sm text-on-surface-variant px-1" %>
            <%= select_tag :genre,
                  options_for_select(Post::GENRE_LABELS.except(:product).map { |value, label| [label, value] }, params[:genre]),
                  include_blank: "すべて",
                  class: "w-full px-4 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary outline-none font-body-md text-body-md appearance-none cursor-pointer" %>
          </div>
        </div>

        <div class="mt-stack-md flex flex-col gap-unit md:max-w-sm">
          <%= label_tag :date_from, "日付", class: "font-label-sm text-label-sm text-on-surface-variant px-1" %>
          <div class="flex items-center gap-2">
            <%= date_field_tag :date_from, @date_from,
                  class: "flex-1 min-w-0 px-3 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary outline-none font-body-md text-body-md" %>
            <span class="text-on-surface-variant text-label-sm shrink-0">〜</span>
            <%= date_field_tag :date_to, @date_to,
                  class: "flex-1 min-w-0 px-3 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary outline-none font-body-md text-body-md" %>
          </div>
        </div>

        <div class="mt-stack-md flex flex-wrap items-center gap-stack-sm">
          <span class="font-label-sm text-label-sm text-on-surface-variant mr-2">リピ判定:</span>
          <% Post::REPEAT_INTENTION_LABELS.each do |value, label| %>
            <label class="flex items-center gap-1 cursor-pointer group">
              <%= check_box_tag "repeat_intentions[]", value, @repeat_intentions.include?(value.to_s),
                    id: "repeat_intention_#{value}", class: "hidden peer" %>
              <div class="px-4 py-1.5 rounded-full border border-outline-variant peer-checked:bg-primary-fixed peer-checked:border-primary-container peer-checked:text-on-primary-fixed-variant transition-all font-label-md text-label-md">
                <%= label %>
              </div>
            </label>
          <% end %>
          <%= submit_tag "検索する",
                class: "ml-auto mt-4 md:mt-0 w-full md:w-auto px-10 py-3 bg-primary text-on-primary font-bold rounded-lg hover:opacity-90 transition-all active:scale-95 shadow-md cursor-pointer" %>
        </div>
      <% end %>

      <% if @posts.any? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-gutter">
          <% @posts.each do |post| %>
            <article class="bg-white rounded-xl overflow-hidden shadow-[0px_4px_20px_rgba(255,82,0,0.05)] hover:shadow-[0px_8px_30px_rgba(0,0,0,0.08)] transition-all group border border-outline-variant/20">
              <%= link_to post_path(post), class: "block" do %>
                <div class="relative aspect-[4/3] overflow-hidden bg-surface-container-high">
                  <% if post.image.attached? %>
                    <%= image_tag post.image, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center text-outline">
                      <span class="material-symbols-outlined text-5xl">shopping_bag</span>
                    </div>
                  <% end %>
                  <div class="absolute top-3 left-3 px-3 py-1 <%= repeat_intention_badge_class(post) %> text-label-sm rounded-full shadow-md font-bold">
                    <%= post.repeat_intention_label %>
                  </div>
                </div>
                <div class="p-stack-md">
                  <div class="flex justify-between items-start mb-2">
                    <h2 class="font-title-md text-title-md text-on-surface leading-tight"><%= post.name %></h2>
                    <% icon, color = repeat_intention_icon(post) %>
                    <span class="material-symbols-outlined fill-icon <%= color %>"><%= icon %></span>
                  </div>
                  <p class="text-on-surface-variant text-body-md line-clamp-2 mb-4"><%= post.memo.presence || "メモはありません" %></p>
                  <div class="flex items-center justify-between">
                    <span class="text-label-sm text-outline font-bold"><%= post.genre_label %></span>
                    <span class="text-on-surface-variant font-bold text-label-md"><%= post.date.strftime("%Y.%m.%d") %></span>
                  </div>
                </div>
              <% end %>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="text-center text-on-surface-variant py-stack-lg">該当する投稿がありません</p>
      <% end %>

      <%= link_to new_post_path(post_type: "purchase"),
            class: "fixed bottom-24 md:bottom-10 right-6 md:right-10 w-14 h-14 md:w-16 md:h-16 bg-primary text-on-primary rounded-full shadow-2xl flex items-center justify-center hover:scale-110 active:scale-95 transition-transform duration-200 z-40" do %>
        <span class="material-symbols-outlined text-3xl">add</span>
      <% end %>
    </main>

    <footer class="w-full py-stack-lg flex-col items-center gap-stack-sm border-t border-primary-fixed-dim bg-primary-fixed mb-16 md:mb-0 hidden md:flex">
      <div class="font-title-md text-title-md font-bold text-on-primary-fixed-variant">これリピ！</div>
      <p class="text-on-primary-fixed-variant font-label-sm text-label-sm mt-stack-sm">© <%= Time.current.year %> これリピ！</p>
    </footer>

    <nav class="md:hidden fixed bottom-0 left-0 w-full bg-white flex justify-around items-center py-3 border-t border-outline-variant/30 z-50">
      <%= link_to posts_path(post_type: "eat_out"), class: "flex flex-col items-center gap-1 text-on-surface-variant" do %>
        <span class="material-symbols-outlined">restaurant</span>
        <span class="text-[10px] font-bold">外食</span>
      <% end %>
      <%= link_to posts_path(post_type: "purchase"), class: "flex flex-col items-center gap-1 text-primary" do %>
        <span class="material-symbols-outlined fill-icon">shopping_bag</span>
        <span class="text-[10px] font-bold">購入品</span>
      <% end %>
      <button type="button" class="flex flex-col items-center gap-1 text-on-surface-variant/40" disabled>
        <span class="material-symbols-outlined">favorite</span>
        <span class="text-[10px] font-bold">マイリスト</span>
      </button>
      <button type="button" class="flex flex-col items-center gap-1 text-on-surface-variant/40" disabled>
        <span class="material-symbols-outlined">person</span>
        <span class="text-[10px] font-bold">プロフィール</span>
      </button>
    </nav>
  </div>
<% else %>
  <% content_for :title, "投稿一覧" %>

  <div class="post-index-page">
    <div class="post-index-header">
      <h1>投稿一覧</h1>
      <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "btn" %>
    </div>

    <nav class="post-type-tabs">
      <%= link_to "すべて", posts_path, class: "tab#{" active" if @post_type.blank?}" %>
      <% Post::POST_TYPE_LABELS.each do |value, label| %>
        <%= link_to label, posts_path(post_type: value), class: "tab#{" active" if @post_type == value.to_s}" %>
      <% end %>
    </nav>

    <% if @posts.any? %>
      <ul class="post-list">
        <% @posts.each do |post| %>
          <li class="post-list-item">
            <%= link_to post_path(post) do %>
              <span class="post-list-type"><%= post.post_type_label %></span>
              <span class="post-list-name"><%= post.name %></span>
              <span class="post-list-date"><%= post.date %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>投稿がありません</p>
    <% end %>

    <%= link_to "投稿する", new_post_path, class: "btn" %>
  </div>
<% end %>
