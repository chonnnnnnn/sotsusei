<% content_for :title, "アカウント設定 - これリピ！" %>

<div class="bg-background text-on-surface font-body-md min-h-screen flex flex-col">
  <header class="fixed top-0 w-full z-50 shadow-sm bg-primary">
    <div class="max-w-7xl mx-auto flex justify-between items-center px-container-margin py-4">
      <h1 class="font-headline-lg text-headline-lg font-black text-on-primary">これリピ！</h1>
      <div class="flex items-center gap-stack-md">
        <span class="material-symbols-outlined fill-icon text-on-primary p-2 rounded-full bg-white/10" title="Account">account_circle</span>
        <%= button_to destroy_user_session_path, method: :delete,
              class: "material-symbols-outlined text-on-primary p-2 hover:bg-white/10 transition-colors rounded-full",
              form: { class: "contents" }, title: "Logout" do %>logout<% end %>
      </div>
    </div>
  </header>

  <main class="flex-grow pt-24 pb-24 md:pb-stack-lg px-container-margin max-w-md mx-auto w-full">
    <div class="mb-stack-lg">
      <%= link_to root_path, class: "flex items-center gap-1 text-primary font-label-md mb-2 w-fit hover:opacity-80 transition-opacity" do %>
        <span class="material-symbols-outlined text-[20px]">arrow_back_ios</span>戻る
      <% end %>
      <h2 class="font-headline-lg text-headline-lg text-on-surface mb-2">アカウント設定</h2>
      <p class="text-on-surface-variant text-body-md">登録情報の確認・変更ができます。</p>
    </div>

    <div class="bg-surface-container-lowest rounded-xl shadow-[0px_4px_20px_rgba(255,82,0,0.05)] p-stack-lg border border-outline-variant/30">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
            html: { method: :put, class: "flex flex-col gap-stack-lg" }) do |f| %>
        <% if resource.errors.any? %>
          <div class="rounded-lg border border-error bg-error-container px-4 py-3 text-on-error-container">
            <p class="font-label-md text-label-md mb-1">入力内容をご確認ください</p>
            <ul class="text-body-md list-disc list-inside">
              <% resource.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <div class="rounded-lg bg-tertiary-fixed text-on-tertiary-fixed-variant px-4 py-3 font-label-md">
            確認待ちのメールアドレス: <%= resource.unconfirmed_email %>
          </div>
        <% end %>

        <div class="flex flex-col gap-stack-sm">
          <%= f.label :email, "メールアドレス", class: "font-label-md text-label-md text-on-surface-variant" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "h-12 px-4 rounded-lg border border-outline-variant bg-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all text-body-md" %>
        </div>

        <div class="flex flex-col gap-stack-sm">
          <%= f.label :password, "パスワード", class: "font-label-md text-label-md text-on-surface-variant" %>
          <span class="font-label-sm text-label-sm text-on-surface-variant">変更しない場合は空欄のままにしてください</span>
          <%= f.password_field :password, autocomplete: "new-password",
                class: "h-12 px-4 rounded-lg border border-outline-variant bg-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all text-body-md" %>
          <% if @minimum_password_length %>
            <span class="font-label-sm text-label-sm text-on-surface-variant"><%= @minimum_password_length %>文字以上</span>
          <% end %>
        </div>

        <div class="flex flex-col gap-stack-sm">
          <%= f.label :password_confirmation, "パスワード（確認）", class: "font-label-md text-label-md text-on-surface-variant" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
                class: "h-12 px-4 rounded-lg border border-outline-variant bg-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all text-body-md" %>
        </div>

        <div class="flex flex-col gap-stack-sm">
          <%= f.label :current_password, "現在のパスワード", class: "font-label-md text-label-md text-on-surface-variant" %>
          <span class="font-label-sm text-label-sm text-on-surface-variant">変更を確定するには現在のパスワードが必要です</span>
          <%= f.password_field :current_password, autocomplete: "current-password",
                class: "h-12 px-4 rounded-lg border border-outline-variant bg-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all text-body-md" %>
        </div>

        <%= f.submit "更新する",
              class: "mt-stack-md bg-primary text-on-primary font-title-md text-title-md py-4 rounded-lg shadow-lg active:scale-[0.98] transition-all hover:bg-primary-container cursor-pointer" %>
      <% end %>
    </div>

    <div class="bg-surface-container-lowest rounded-xl p-stack-lg border border-outline-variant/30 mt-stack-lg">
      <h3 class="font-title-md text-title-md text-error mb-2">退会</h3>
      <p class="text-on-surface-variant text-body-md mb-stack-md">退会するとすべての投稿データが削除され、元に戻すことはできません。</p>
      <%= button_to "アカウントを削除する", registration_path(resource_name),
            method: :delete,
            data: { confirm: "本当に退会しますか？", turbo_confirm: "本当に退会しますか？" },
            class: "border border-error text-error px-6 py-3 rounded-lg font-label-md hover:bg-error-container transition-colors",
            form: { class: "contents" } %>
    </div>
  </main>

  <footer class="w-full py-stack-lg flex-col items-center gap-stack-sm border-t border-primary-fixed-dim bg-primary-fixed mb-16 md:mb-0 hidden md:flex">
    <div class="font-title-md text-title-md font-bold text-on-primary-fixed-variant">これリピ！</div>
    <p class="text-on-primary-fixed-variant font-label-sm text-label-sm mt-stack-sm">© <%= Time.current.year %> これリピ！</p>
  </footer>

  <nav class="md:hidden fixed bottom-0 left-0 w-full bg-white flex justify-around items-center py-3 border-t border-outline-variant/30 z-50">
    <%= link_to posts_path(post_type: "eat_out"), class: "flex flex-col items-center gap-1 text-on-surface-variant" do %>
      <span class="material-symbols-outlined">restaurant</span>
      <span class="text-[10px] font-bold">外食</span>
    <% end %>
    <%= link_to posts_path(post_type: "purchase"), class: "flex flex-col items-center gap-1 text-on-surface-variant" do %>
      <span class="material-symbols-outlined">shopping_bag</span>
      <span class="text-[10px] font-bold">購入品</span>
    <% end %>
    <button type="button" class="flex flex-col items-center gap-1 text-on-surface-variant/40" disabled>
      <span class="material-symbols-outlined">favorite</span>
      <span class="text-[10px] font-bold">マイリスト</span>
    </button>
    <div class="flex flex-col items-center gap-1 text-primary">
      <span class="material-symbols-outlined fill-icon">person</span>
      <span class="text-[10px] font-bold">プロフィール</span>
    </div>
  </nav>
</div>
