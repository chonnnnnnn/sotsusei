<% if @post.post_type == "eat_out" %>
  <% content_for :title, "投稿編集 | これリピ！" %>

  <div class="bg-surface font-body-md text-on-surface min-h-screen flex flex-col">
    <header class="fixed top-0 w-full z-50 flex justify-between items-center px-container-margin py-4 bg-surface shadow-sm max-w-7xl mx-auto left-0 right-0">
      <div class="font-headline-lg text-headline-lg font-black text-primary">これリピ！</div>
      <div class="flex items-center gap-stack-md">
        <%= link_to edit_user_registration_path, class: "material-symbols-outlined text-on-surface-variant hover:bg-surface-container-low transition-colors p-2 rounded-full active:scale-95 duration-200", title: "Account" do %>account_circle<% end %>
        <%= button_to destroy_user_session_path, method: :delete,
              class: "material-symbols-outlined text-on-surface-variant hover:bg-surface-container-low transition-colors p-2 rounded-full active:scale-95 duration-200",
              form: { class: "contents" }, title: "Logout" do %>logout<% end %>
      </div>
    </header>

    <main class="flex-grow pt-24 pb-stack-lg px-container-margin mx-auto max-w-md w-full">
      <%= render "breadcrumb", crumbs: [["ホーム", root_path], ["外食", posts_path(post_type: "eat_out")], [@post.name, post_path(@post)], ["編集", nil]] %>

      <h1 class="font-title-md text-title-md text-on-surface mb-stack-md">投稿を編集</h1>

      <div class="bg-surface-container-lowest rounded-xl shadow-[0px_4px_20px_rgba(255,82,0,0.05)] p-6 md:p-8">
        <%= form_with model: @post, multipart: true, class: "flex flex-col gap-stack-lg" do |f| %>
          <%= f.hidden_field :post_type, value: "eat_out" %>

          <% if @post.errors.any? %>
            <div class="rounded-lg border border-error bg-error-container px-4 py-3 text-on-error-container">
              <p class="font-label-md text-label-md mb-1">入力内容をご確認ください</p>
              <ul class="text-body-md list-disc list-inside">
                <% @post.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <label class="relative group cursor-pointer overflow-hidden rounded-lg aspect-square w-full max-w-[300px] mx-auto border-2 border-dashed border-outline-variant hover:border-primary transition-colors flex flex-col items-center justify-center bg-surface-container">
            <% if @post.image.attached? %>
              <%= image_tag @post.image, class: "w-full h-full object-cover" %>
              <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity">
                <span class="material-symbols-outlined text-white text-4xl">edit</span>
              </div>
            <% else %>
              <span class="material-symbols-outlined text-primary text-4xl mb-2">add_a_photo</span>
              <span class="font-label-md text-on-surface-variant">写真をアップロード</span>
            <% end %>
            <%= f.file_field :image, accept: "image/*", class: "hidden" %>
          </label>

          <div class="flex flex-col gap-stack-sm">
            <%= f.label :name, "店名", class: "font-label-md text-label-md text-on-surface-variant" %>
            <%= f.text_field :name, placeholder: "店名を入力してください",
                  class: "h-12 px-4 rounded-lg border border-outline-variant bg-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all text-body-md" %>
          </div>

          <div class="flex flex-col gap-stack-sm">
            <%= f.label :prefecture, "都道府県", class: "font-label-md text-label-md text-on-surface-variant" %>
            <%= f.select :prefecture, Post::PREFECTURES, { include_blank: "都道府県を選択" },
                  class: "h-12 px-4 rounded-lg border border-outline-variant bg-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all text-body-md appearance-none" %>
          </div>

          <div class="flex flex-col gap-stack-sm">
            <%= f.label :date, "日付", class: "font-label-md text-label-md text-on-surface-variant" %>
            <%= f.date_field :date,
                  class: "h-12 px-4 rounded-lg border border-outline-variant bg-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all text-body-md" %>
          </div>

          <div class="flex flex-col gap-stack-sm">
            <span class="font-label-md text-label-md text-on-surface-variant">ジャンル</span>
            <div class="flex flex-wrap gap-2">
              <% Post::GENRE_LABELS.except(:product).each do |value, label| %>
                <label class="cursor-pointer">
                  <%= f.radio_button :genre, value, class: "hidden peer" %>
                  <span class="px-5 py-2 rounded-full border border-outline-variant text-label-md peer-checked:bg-primary-container peer-checked:text-on-primary-container peer-checked:border-primary-container transition-all inline-block"><%= label %></span>
                </label>
              <% end %>
            </div>
          </div>

          <div class="flex flex-col gap-stack-sm">
            <span class="font-label-md text-label-md text-on-surface-variant">リピート判定</span>
            <div class="grid grid-cols-3 gap-gutter">
              <% Post::REPEAT_INTENTION_LABELS.each do |value, label| %>
                <% icon, color = repeat_intention_selector_icon(value) %>
                <label class="cursor-pointer">
                  <%= f.radio_button :repeat_intention, value, class: "hidden peer" %>
                  <span class="flex flex-col items-center gap-2 py-4 border border-outline-variant rounded-lg peer-checked:border-primary-container peer-checked:bg-primary-container peer-checked:text-on-primary-container peer-checked:shadow-[0_4px_12px_rgba(168,51,0,0.2)] hover:bg-surface-container-low peer-checked:hover:bg-primary-container transition-all">
                    <span class="material-symbols-outlined <%= color %>"><%= icon %></span>
                    <span class="font-label-md"><%= label %></span>
                  </span>
                </label>
              <% end %>
            </div>
          </div>

          <div class="flex flex-col gap-stack-sm">
            <%= f.label :memo, "メモ", class: "font-label-md text-label-md text-on-surface-variant" %>
            <%= f.text_area :memo, placeholder: "メモを入力してください", rows: 4,
                  class: "p-4 rounded-lg border border-outline-variant bg-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all text-body-md resize-none" %>
          </div>

          <div class="pt-4">
            <button type="submit" class="w-full bg-primary text-white h-14 rounded-lg font-title-md text-title-md shadow-lg active:scale-[0.98] transition-all hover:brightness-110 flex items-center justify-center gap-2 cursor-pointer">
              <span class="material-symbols-outlined">check_circle</span>更新する
            </button>
          </div>
        <% end %>

        <div class="pt-stack-sm">
          <%= button_to post_path(@post), method: :delete,
                class: "w-full bg-transparent text-error border border-error-container h-12 rounded-lg font-label-md text-label-md active:scale-[0.98] transition-all hover:bg-error-container/20 flex items-center justify-center gap-2 cursor-pointer",
                form: { data: { turbo_confirm: "本当に削除しますか？" } } do %>
            <span class="material-symbols-outlined">delete</span>この投稿を削除する
          <% end %>
        </div>
      </div>
    </main>

    <footer class="w-full py-stack-lg flex flex-col items-center gap-stack-sm border-t border-outline-variant bg-surface-container-lowest mt-12">
      <div class="font-title-md text-title-md font-bold text-on-surface-variant">これリピ！ (Kore-Repi!)</div>
      <p class="font-label-sm text-label-sm text-on-surface-variant opacity-60">© <%= Time.current.year %> これリピ！ (Kore-Repi!)</p>
    </footer>
  </div>
<% elsif @post.post_type == "purchase" %>
  <% content_for :title, "投稿編集 - これリピ！" %>

  <div class="bg-surface text-on-surface font-body-md min-h-screen flex flex-col">
    <header class="fixed top-0 w-full z-50 bg-surface shadow-sm px-container-margin py-4 flex justify-between items-center max-w-7xl mx-auto left-0 right-0">
      <div class="font-headline-lg text-headline-lg font-black text-primary">これリピ！</div>
      <div class="flex items-center gap-4 text-on-surface-variant">
        <%= link_to edit_user_registration_path, class: "hover:bg-surface-container-low transition-colors p-2 rounded-full active:scale-95 duration-200" do %>
          <span class="material-symbols-outlined">account_circle</span>
        <% end %>
        <%= button_to destroy_user_session_path, method: :delete,
              class: "hover:bg-surface-container-low transition-colors p-2 rounded-full active:scale-95 duration-200",
              form: { class: "contents" } do %>
          <span class="material-symbols-outlined">logout</span>
        <% end %>
      </div>
    </header>

    <main class="flex-grow pt-24 pb-stack-lg px-container-margin">
      <div class="max-w-md mx-auto">
        <%= render "breadcrumb", crumbs: [["ホーム", root_path], ["購入品", posts_path(post_type: "purchase")], [@post.name, post_path(@post)], ["編集", nil]] %>

        <h1 class="font-title-md text-title-md text-on-surface mb-stack-md">購入品の編集</h1>

        <section class="bg-surface-container-lowest p-stack-lg rounded-xl shadow-[0px_4px_20px_rgba(168,51,0,0.05)]">
          <%= form_with model: @post, multipart: true, class: "space-y-stack-md" do |f| %>
            <%= f.hidden_field :post_type, value: "purchase" %>

            <% if @post.errors.any? %>
              <div class="rounded-lg border border-error bg-error-container px-4 py-3 text-on-error-container">
                <p class="font-label-md text-label-md mb-1">入力内容をご確認ください</p>
                <ul class="text-body-md list-disc list-inside">
                  <% @post.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="space-y-unit mb-stack-lg">
              <span class="font-label-sm text-label-sm text-on-surface-variant flex items-center gap-1">
                <span class="material-symbols-outlined text-[16px]">add_a_photo</span>商品写真
              </span>
              <label class="relative group cursor-pointer block">
                <div class="w-full h-48 rounded-xl bg-surface-container border-2 border-dashed border-outline-variant flex flex-col items-center justify-center gap-2 hover:border-primary transition-colors overflow-hidden">
                  <% if @post.image.attached? %>
                    <%= image_tag @post.image, class: "w-full h-full object-cover" %>
                    <div class="absolute inset-0 bg-black/20 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                      <span class="text-white font-label-md">写真を変更する</span>
                    </div>
                  <% else %>
                    <span class="material-symbols-outlined text-primary text-4xl">add_a_photo</span>
                    <span class="font-label-md text-on-surface-variant">写真をアップロード</span>
                  <% end %>
                </div>
                <%= f.file_field :image, accept: "image/*", class: "hidden" %>
              </label>
            </div>

            <div class="space-y-unit">
              <%= f.label :name, class: "font-label-sm text-label-sm text-on-surface-variant flex items-center gap-1" do %>
                <span class="material-symbols-outlined text-[16px]">shopping_bag</span>商品名
              <% end %>
              <%= f.text_field :name, placeholder: "商品名を入力してください",
                    class: "w-full h-12 px-4 rounded-lg border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all font-body-md text-body-md text-on-surface bg-white" %>
            </div>

            <div class="space-y-unit">
              <%= f.label :date, class: "font-label-sm text-label-sm text-on-surface-variant flex items-center gap-1" do %>
                <span class="material-symbols-outlined text-[16px]">calendar_today</span>日付
              <% end %>
              <%= f.date_field :date,
                    class: "w-full h-12 px-4 rounded-lg border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all font-body-md text-body-md text-on-surface bg-white" %>
            </div>

            <div class="space-y-unit">
              <span class="font-label-sm text-label-sm text-on-surface-variant flex items-center gap-1">ジャンル</span>
              <div class="flex flex-wrap gap-2">
                <% Post::GENRE_LABELS.except(:product).each do |value, label| %>
                  <label class="cursor-pointer">
                    <%= f.radio_button :genre, value, class: "hidden peer" %>
                    <span class="px-5 py-2 rounded-full border border-outline-variant text-label-md peer-checked:bg-primary-container peer-checked:text-on-primary-container peer-checked:border-primary-container transition-all inline-block"><%= label %></span>
                  </label>
                <% end %>
              </div>
            </div>

            <div class="space-y-unit pt-2">
              <span class="font-label-sm text-label-sm text-on-surface-variant flex items-center gap-1 mb-2">
                <span class="material-symbols-outlined text-[16px]">repeat</span>リピート判定
              </span>
              <div class="grid grid-cols-3 gap-2">
                <% Post::REPEAT_INTENTION_LABELS.each do |value, label| %>
                  <% icon, color = repeat_intention_selector_icon(value) %>
                  <label class="cursor-pointer">
                    <%= f.radio_button :repeat_intention, value, class: "hidden peer" %>
                    <span class="flex flex-col items-center justify-center py-3 rounded-lg border border-outline-variant peer-checked:border-primary-container peer-checked:bg-primary-container peer-checked:text-on-primary-container hover:bg-surface-container-low peer-checked:hover:bg-primary-container transition-colors">
                      <span class="material-symbols-outlined text-[24px] mb-1 <%= color %>"><%= icon %></span>
                      <span class="font-label-sm text-label-sm"><%= label %></span>
                    </span>
                  </label>
                <% end %>
              </div>
            </div>

            <div class="space-y-unit pt-2">
              <%= f.label :memo, "メモ", class: "font-label-sm text-label-sm text-on-surface-variant" %>
              <%= f.text_area :memo, placeholder: "味の感想や選んだ理由など...", rows: 3,
                    class: "w-full p-4 rounded-lg border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all font-body-md text-body-md text-on-surface bg-white resize-none" %>
            </div>

            <div class="pt-stack-md">
              <button type="submit" class="w-full h-14 bg-primary text-on-primary font-title-md text-title-md rounded-lg shadow-md hover:opacity-90 active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer">
                <span>更新する</span><span class="material-symbols-outlined">check_circle</span>
              </button>
            </div>
          <% end %>

          <%= button_to post_path(@post), method: :delete,
                class: "w-full mt-4 text-on-surface-variant font-label-md text-label-md hover:text-error transition-colors py-2 cursor-pointer",
                form: { data: { turbo_confirm: "本当に削除しますか?" } } do %>この投稿を削除する<% end %>
        </section>
      </div>
    </main>

    <footer class="w-full py-stack-lg flex flex-col items-center gap-stack-sm border-t border-outline-variant bg-surface-container-lowest">
      <div class="font-title-md text-title-md font-bold text-on-surface-variant">これリピ！</div>
      <p class="font-label-sm text-label-sm text-on-surface-variant mt-2">© <%= Time.current.year %> これリピ！ (Kore-Repi!)</p>
    </footer>
  </div>
<% else %>
  <% content_for :title, "投稿を編集" %>

  <div class="post-form-page">
    <nav class="breadcrumb">
      <%= link_to "ホーム", root_path %> &gt;
      <%= link_to @post.post_type_label, posts_path(post_type: @post.post_type) %> &gt;
      <%= link_to @post.name, post_path(@post) %> &gt;
      <span class="current">編集</span>
    </nav>

    <h1>投稿を編集</h1>

    <%= render "form", post: @post, submit_label: "更新する" %>
  </div>
<% end %>
