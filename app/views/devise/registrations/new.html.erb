<% content_for :title, "これリピ！ - 新規登録" %>

<div class="font-body-md text-body-md min-h-screen flex flex-col bg-surface">
  <header class="w-full top-0 sticky bg-surface/80 backdrop-blur-md shadow-sm z-50">
    <div class="flex items-center justify-between px-container-margin h-20 w-full max-w-[1200px] mx-auto">
      <div class="flex items-center gap-3">
        <span class="material-symbols-outlined text-primary text-3xl">restaurant_menu</span>
        <h1 class="font-headline-lg-mobile text-headline-lg-mobile font-bold text-primary tracking-tight">これリピ！</h1>
      </div>
    </div>
  </header>

  <main class="flex-grow flex items-center justify-center p-6 md:p-12 lg:p-16 flex-col">
    <div class="w-full max-w-[500px] bg-white rounded-[2rem] shadow-2xl overflow-hidden flex flex-col border border-surface-container-high mx-auto">
      <div class="w-full p-8 md:p-12 flex flex-col justify-center bg-white">
        <div class="mb-10">
          <h2 class="font-headline-lg text-headline-lg text-on-surface mb-3">新規登録</h2>
          <p class="text-on-surface-variant font-body-md leading-relaxed">これリピ！へようこそ。アカウントを作成して、美味しい体験を記録し始めましょう。</p>
        </div>

        <% if resource.errors.any? %>
          <div class="mb-6 rounded-xl border border-error bg-error-container px-5 py-4 text-on-error-container">
            <p class="font-label-md text-label-md mb-2">
              <%= I18n.t("errors.messages.not_saved", count: resource.errors.count, resource: resource.class.model_name.human.downcase) %>
            </p>
            <ul class="list-disc list-inside text-body-md">
              <% resource.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "flex flex-col gap-6" }) do |f| %>
          <div class="flex flex-col gap-2">
            <%= f.label :username, "ユーザー名", class: "font-label-md text-on-surface-variant ml-1" %>
            <%= f.text_field :username, autofocus: true, placeholder: "example_user",
                  class: "h-14 w-full px-5 rounded-xl border border-outline-variant bg-surface-bright text-on-surface font-body-md form-input-focus transition-all duration-200 placeholder:text-outline/50" %>
          </div>

          <div class="flex flex-col gap-2">
            <%= f.label :email, "メールアドレス", class: "font-label-md text-on-surface-variant ml-1" %>
            <%= f.email_field :email, autocomplete: "email", placeholder: "example@mail.com",
                  class: "h-14 w-full px-5 rounded-xl border border-outline-variant bg-surface-bright text-on-surface font-body-md form-input-focus transition-all duration-200 placeholder:text-outline/50" %>
          </div>

          <div class="flex flex-col gap-2">
            <%= f.label :password, "パスワード", class: "font-label-md text-on-surface-variant ml-1" %>
            <%= f.password_field :password, autocomplete: "new-password", placeholder: "example123",
                  class: "h-14 w-full px-5 rounded-xl border border-outline-variant bg-surface-bright text-on-surface font-body-md form-input-focus transition-all duration-200 placeholder:text-outline/50" %>
            <% if @minimum_password_length %>
              <p class="text-label-sm text-on-surface-variant ml-1"><%= @minimum_password_length %>文字以上で入力してください</p>
            <% end %>
          </div>

          <div class="flex flex-col gap-2">
            <%= f.label :password_confirmation, "パスワード確認", class: "font-label-md text-on-surface-variant ml-1" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "example123",
                  class: "h-14 w-full px-5 rounded-xl border border-outline-variant bg-surface-bright text-on-surface font-body-md form-input-focus transition-all duration-200 placeholder:text-outline/50" %>
          </div>

          <%= f.submit "登録",
                class: "mt-4 h-16 w-full bg-primary text-on-primary font-title-md text-title-md rounded-xl shadow-lg hover:bg-primary-container hover:shadow-xl active:scale-[0.98] transition-all duration-200 cursor-pointer" %>
        <% end %>

        <div class="mt-10 text-center">
          <p class="text-on-surface-variant font-label-md">
            既にアカウントをお持ちですか？
            <%= link_to "ログイン", new_session_path(resource_name), class: "text-primary font-bold hover:underline ml-2 transition-colors" %>
          </p>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center gap-2 opacity-40 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-500 mt-10">
      <p class="text-[10px] text-on-surface-variant/70">© <%= Time.current.year %> Kore-Repeat! All Rights Reserved.</p>
    </div>
  </main>
</div>
