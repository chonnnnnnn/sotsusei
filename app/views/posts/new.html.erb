<% else %>
  <% content_for :title, "投稿する" %>

  <div class="post-form-page">
    <nav class="breadcrumb">
      <%= link_to "← 戻る", root_path %>
    </nav>

    <h1>投稿する</h1>

    <%= render "form", post: @post, submit_label: "投稿する" %>
  </div>
<% end %>
