<%= form_with model: post, multipart: true, data: { controller: "post-form" } do |f| %>
  <% if post.errors.any? %>
    <div class="error-messages">
      <h2><%= post.errors.count %>件のエラーがあります</h2>
      <ul>
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset class="field">
    <legend>種別</legend>
    <% Post::POST_TYPE_LABELS.each do |value, label| %>
      <label class="radio-label">
        <%= f.radio_button :post_type, value, data: { post_form_target: "postType", action: "change->post-form#togglePrefecture" } %>
        <%= label %>
      </label>
    <% end %>
  </fieldset>

  <div class="field">
    <%= f.label :date, "日付" %>
    <%= f.date_field :date %>
  </div>

  <div class="field">
    <%= f.label :name, "店名・商品名" %>
    <%= f.text_field :name %>
  </div>

  <div class="field" data-post-form-target="prefectureField">
    <%= f.label :prefecture, "都道府県" %>
    <%= f.select :prefecture, Post::PREFECTURES, include_blank: "選択してください" %>
  </div>

  <fieldset class="field">
    <legend>ジャンル</legend>
    <% Post::GENRE_LABELS.each do |value, label| %>
      <label class="radio-label">
        <%= f.radio_button :genre, value %>
        <%= label %>
      </label>
    <% end %>
  </fieldset>

  <fieldset class="field">
    <legend>リピート判定</legend>
    <% Post::REPEAT_INTENTION_LABELS.each do |value, label| %>
      <label class="radio-label">
        <%= f.radio_button :repeat_intention, value %>
        <%= label %>
      </label>
    <% end %>
  </fieldset>

  <div class="field">
    <%= f.label :memo, "一言メモ" %>
    <%= f.text_area :memo %>
  </div>

  <div class="field">
    <%= f.label :image, "画像" %>
    <% if post.image.attached? %>
      <%= image_tag post.image, class: "post-image-preview" %>
    <% end %>
    <%= f.file_field :image, accept: "image/*" %>
  </div>

  <%= f.submit submit_label %>

  <%= form_with(model: post) do |form| %>
    <div>
      <%= form.label :image, "画像" %>
      <%= form.file_field :image %>
    </div>
    <%= form.submit %>
  <% end %>
<% end %>
